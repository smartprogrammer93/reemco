# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# build-time commit stamp (written by infra/Dockerfile from REEMCO_COMMIT)
/public/__commit.txt

# typescript
*.tsbuildinfo
next-env.d.ts

# REEA-37 local funnel event store
.events/
.events-test-*/
.collect-cache/

# REEA-1044 metrics test scratch dir
.metrics-tests/

# local metrics store (src/lib/metrics.ts falls back here without KV)
.metrics/

# REEA-1051/1067 adapter-probe output (written by scripts/reea1051-adapter-probe.mjs)
reea1051-adapter-probe.json

# REEA-1069 local probe scratch
/.metrics/
/probe-1069.tmp.mjs
/probe2-1069.tmp.mjs
/probe-product.tmp.mjs
/probe-y.tmp.mjs

# REEA-1069 local verification probes (scratch, not shipped)
/probe*.tmp.mjs
