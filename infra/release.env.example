# REEA-1044 — non-secret site configuration.
#
# Location on the host: /etc/reemco/release.env, mode 0640, owner root:deploy.
# No credentials belong in this file; it is safe to read in a deploy log.
#
# Standup: set this to the box's public IP. Caddy serves plain HTTP and
#          verify.sh talks http:// — no DNS change needed yet.
# Cutover: set this to the real hostname. Caddy provisions Let's Encrypt TLS
#          automatically; promoting to production is this one line plus
#          `docker compose up -d proxy` — reversible by putting the IP back.

REEMCO_SITE_ADDRESS=203.0.113.10

# Registry and token for the on-box Upstash-compatible gateway (local-kv
# profile only). Not a secret in the strict sense, but rotate it anyway.
# REEMCO_KV_TOKEN=change-me-local-kv-token
