# REEA-1044 — non-secret site configuration.
#
# Location on the host: /etc/reemco/release.env, mode 0640, owner root:deploy.
# No credentials belong in this file; it is safe to read in a deploy log.
#
# Standup: set this to the box's public hostname (or IP). A hostname gets
#          automatic Let's Encrypt TLS; a bare IP stays on plain HTTP.
# Cutover: the same one line — promoting to production is this value plus
#          `sudo /opt/reemco/scripts/deploy.sh --tag <sha>`; reversible by
#          putting the previous address back.

REEMCO_SITE_ADDRESS=ns539626.ip-144-217-72.net

# Image repository. During standup the image is built on the host (no registry
# credentials), so this is a local repo name: `docker build -t reemco/app:<sha>`.
# When the GHCR workflow is wired with DEPLOY_SSH_KEY etc., set this to
# ghcr.io/<org>/<repo> and deploy.sh pulls instead of using the local build.
REEMCO_IMAGE_REPO=reemco/app

# Compose profiles to enable. The production stack (app + Valkey + Caddy) needs
# none; the app reaches Valkey over the private compose network via REDIS_URL,
# which compose.prod.yml sets. Leave this empty unless a future profile is added.
REEMCO_COMPOSE_PROFILES=
