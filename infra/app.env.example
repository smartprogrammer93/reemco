# REEA-1044 — runtime secrets for the app container.
#
# Location on the host: /etc/reemco/app.env, mode 0640, owner root:deploy.
# Provisioned by infra/ansible/playbook.yml from this example ONLY when absent,
# so the real values are never overwritten by a playbook run.
#
# Never commit real values. Never echo them in a deploy log. Inject them from a
# secrets manager or paste them once on the host — the file is the boundary.
#
# Least privilege: this is the app's complete secret surface. If a value is not
# here, the app cannot see it.

# Shared collect-job / metrics store, Upstash REST contract.
# Option A (hosted): point at the existing Upstash store.
# Option B (on-box): enable the local-kv compose profile and use
#   KV_REST_API_URL=http://kv-rest:80
#   KV_REST_API_TOKEN=<REEMCO_KV_TOKEN from release.env>
# Leave both empty to degrade to the per-instance local store (kv.ts design).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Do NOT set VERCEL or AWS_LAMBDA_FUNCTION_NAME here: those flip the event,
# metrics and collect stores to /tmp. compose.prod.yml injects the durable
# /data/* paths instead, and this file must not override them.

# Optional: override the CSP mode (default is the strict nonce policy).
# CSP_MODE=
