# infra/backup.env.example — copy to /etc/reemco/backup.env (0640 root:root).
# Injected on the host only. Never commit the real file or the password.
#
# RESTIC_REPOSITORY accepts any restic backend. For an off-box bucket use:
#   RESTIC_REPOSITORY=s3:https://s3.us-west-004.backblazeb2.com/reemco-backup
#   RESTIC_REPOSITORY=s3:https://<account>.r2.cloudflarestorage.com/reemco-backup
# and add AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (or B2_ACCOUNT_ID /
# B2_ACCOUNT_KEY) below. They are secrets — this file is 0640 and never committed.
#
# The password file must exist and stay 0600 root:root. Losing it means losing
# the repository: keep a copy in the company secrets manager.
RESTIC_REPOSITORY=/var/backups/reemco-restic
RESTIC_PASSWORD_FILE=/etc/reemco/restic.pass

# Optional: override the backed-up paths (default is the four docker volumes
# plus /opt/reemco and /etc/reemco).
# BACKUP_PATHS=/var/lib/docker/volumes/reemco_metrics/_data /var/lib/docker/volumes/reemco_events/_data
