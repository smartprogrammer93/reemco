[Unit]
# REEA-1044 — scheduled /api/health probe (08:17 UTC), owned by the box since
# the Vercel cron was decommissioned (REEA-1076).
# Observability-before-Launch: the funnel's own health endpoint must be hit on
# a schedule so a dead origin surfaces as a failed unit, not silence.
Description=Reemco health probe (scheduled)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
# Local loopback: no TLS/DNS dependency, so the probe cannot fail because of
# Caddy or the certificate. A non-2xx exits non-zero and lands in the journal.
# REEA-1262 — the port is resolved from the active blue/green slot in
# /etc/reemco/image-tag.env (blue 3000, green 3001) by health-probe.sh, so the
# probe follows a slot switch instead of probing an idle slot.
ExecStart=/opt/reemco/scripts/health-probe.sh
TimeoutStartSec=60
