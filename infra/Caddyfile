# infra/Caddyfile — REEA-1044 reverse proxy + automatic TLS.
#
# The site address comes from /etc/reemco/release.env (REEMCO_SITE_ADDRESS):
#   * during standup: the box's public IP -> plain HTTP, no DNS needed yet
#   * at cutover:     the real hostname -> Caddy provisions Let's Encrypt TLS
# That is the same file, so promoting to production is a one-line env change
# plus `docker compose up -d proxy` — reversible by putting the IP back.
#
# Header ownership (important): the app's middleware (src/proxy.ts) sets the
# per-request nonce CSP, X-Content-Type-Options and Referrer-Policy. Caddy must
# NOT set those again or it would overwrite the nonce policy, so this file only
# adds the one header the app cannot emit: HSTS.
{$REEMCO_SITE_ADDRESS} {
	encode zstd gzip

	header {
		# 2 years, subdomains included, preload-eligible (REEA-1061). Only
		# meaningful over HTTPS; ignored on a plain-HTTP standup address, so the
		# same config works for both. Preload is safe once the served hostname
		# has a valid certificate — the cutover hostname must be submitted to
		# hstspreload.org separately; this only sets the required header.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}

	# The deploy verification gate (infra/scripts/verify.sh + CI) expects the
	# app to answer on these paths through the proxy, unchanged from Vercel.
	reverse_proxy app:3000 {
		health_uri /__commit.txt
		health_interval 30s
		health_timeout 5s
	}

	log {
		output stdout
		format json
	}
}

# REEA-1061 — the HTTP->HTTPS redirect Caddy generates automatically is not
# covered by the site block's header directive, so `Server: Caddy` leaked on
# the 308. Declaring the HTTP site explicitly disables that automatic redirect
# for this host and lets us emit the redirect ourselves with -Server, keeping
# the same 308 status the automatic path used.
#
# Caveat: this block is only valid while REEMCO_SITE_ADDRESS is a DNS name. If
# the box ever falls back to a bare IP (plain-HTTP standup), Caddy sees
# `http://<ip>` twice (the `{$REEMCO_SITE_ADDRESS}` block above is also HTTP for
# an IP) and refuses to start — comment this block out in that case.
http://{$REEMCO_SITE_ADDRESS} {
	header -Server
	redir https://{host}{uri} 308
}
