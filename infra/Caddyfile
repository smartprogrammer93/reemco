# infra/Caddyfile — REEA-1044 reverse proxy + automatic TLS.
#
# The site address comes from /etc/reemco/release.env (REEMCO_SITE_ADDRESS):
#   * during standup: the box's public IP -> plain HTTP, no DNS needed yet
#   * at cutover:     the real hostname -> Caddy provisions Let's Encrypt TLS
# That is the same file, so promoting to production is a one-line env change
# plus `docker compose up -d proxy` — reversible by putting the IP back.
#
# Header ownership (important): the app's middleware (src/proxy.ts) sets the
# per-request nonce CSP, X-Content-Type-Options and Referrer-Policy. Caddy must
# NOT set those again or it would overwrite the nonce policy, so this file only
# adds the one header the app cannot emit: HSTS.
{$REEMCO_SITE_ADDRESS} {
	encode zstd gzip

	header {
		# 2 years, subdomains included, preload-eligible (REEA-1061). Only
		# meaningful over HTTPS; ignored on a plain-HTTP standup address, so the
		# same config works for both. Preload is safe once the served hostname
		# has a valid certificate — the cutover hostname must be submitted to
		# hstspreload.org separately; this only sets the required header.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}

	# REEA-1059 — locale Vary on the results addresses. The app declares this
	# list (src/proxy.ts sharedWindowHeaders + next.config headers()), but on
	# the self-hosted standalone runtime Next 16's app-router response writes
	# its own Vary over it, so the served header drops Accept-Language and a
	# shared cache could hand one locale's results to another. There is no
	# shared cache in front of Caddy today; a CDN at the DNS cutover would make
	# this real. Re-assert the app's exact list at the edge, where nothing
	# overwrites it. scripts/smoke-check.mjs step 8 asserts it on the wire, so
	# a change here is checked by the deploy gate. If sharedWindowHeaders()
	# changes, change these two lines in the same commit.
	header /results* Vary "Accept-Language, rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch, Accept-Encoding"
	header /search* Vary "Accept-Language, rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch, Accept-Encoding"

	# REEA-1262 — the upstream is the ACTIVE app slot, injected from
	# /etc/reemco/image-tag.env. deploy.sh/rollback.sh switch it with
	# `docker exec -e REEMCO_APP_UPSTREAM=<slot>:3000 … caddy reload`; the CLI
	# adapts this file with the exec process environment, Caddy validates the
	# new config and keeps the running one on error. The `:app:3000` default
	# keeps a cold start / un-migrated host working.
	#
	# REEA-1085 (F7b) — drop the proxy fingerprint. reverse_proxy adds
	# `Via: 1.1 Caddy` to every forwarded response AFTER the header/header_down
	# directives run, so `header -Via` / `header_down -Via` cannot remove it and
	# `omit_via_header` does not exist in the pinned Caddy 2.11.9. The documented
	# workaround is to intercept the response, strip Via, then copy it through
	# (caddyserver/caddy#7643). RFC 9110 §7.6.3 makes response-side Via a MAY, so
	# this only removes recon signal; nothing functional depends on the header.
	# verify.sh step 2 fails the deploy if Via leaks again, and smoke steps 1-8
	# (incl. /results and /search, streaming/RSC) gate that handle_response did
	# not change proxied behaviour.
	reverse_proxy {$REEMCO_APP_UPSTREAM:app:3000} {
		# REEA-1262 — a 5xx FROM THE APP must not reach a shopper as an empty
		# body either (AC-4). Match on the upstream status and replace the body
		# with a readable page plus Retry-After; keep the upstream status code
		# so monitoring still sees 500/502/503/504. 4xx and 2xx are untouched
		# (handle_response only runs for the matched statuses).
		@app5xx status 500 502 503 504
		handle_response @app5xx {
			header -Server
			header Retry-After "5"
			header Content-Type "text/html; charset=utf-8"
			respond "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Reemco — temporarily unavailable</title></head><body style=\"font-family:system-ui,sans-serif;max-width:32rem;margin:15vh auto;padding:0 1rem\"><h1>We are checking prices again</h1><p>Reemco is briefly unavailable. Please try again in a few seconds.</p><p><a href=\"/\">Reload the home page</a></p></body></html>" {rp.status_code}
		}
		handle_response {
			header -Via
			copy_response
		}
		health_uri /__commit.txt
		health_interval 30s
		health_timeout 5s
	}

	# REEA-1262 — Caddy's OWN errors (no healthy upstream: connection refused /
	# dial timeout while a slot is being swapped or during a cold start) are not
	# upstream responses, so the handle_response above cannot see them. AC-4:
	# answer a readable page with Retry-After instead of Caddy's empty 503.
	handle_errors {
		@caddy5xx expression {err.status_code} >= 500
		handle @caddy5xx {
			header -Server
			header Retry-After "5"
			header Content-Type "text/html; charset=utf-8"
			respond "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Reemco — temporarily unavailable</title></head><body style=\"font-family:system-ui,sans-serif;max-width:32rem;margin:15vh auto;padding:0 1rem\"><h1>We are checking prices again</h1><p>Reemco is briefly unavailable. Please try again in a few seconds.</p><p><a href=\"/\">Reload the home page</a></p></body></html>" {err.status_code}
		}
		handle {
			header -Server
			respond "{err.status_code} {err.status_text}"
		}
	}

	log {
		output stdout
		format json
	}
}

# REEA-1061 — the HTTP->HTTPS redirect Caddy generates automatically is not
# covered by the site block's header directive, so `Server: Caddy` leaked on
# the 308. Declaring the HTTP site explicitly disables that automatic redirect
# for this host and lets us emit the redirect ourselves with -Server, keeping
# the same 308 status the automatic path used.
#
# Caveat: this block is only valid while REEMCO_SITE_ADDRESS is a DNS name. If
# the box ever falls back to a bare IP (plain-HTTP standup), Caddy sees
# `http://<ip>` twice (the `{$REEMCO_SITE_ADDRESS}` block above is also HTTP for
# an IP) and refuses to start — comment this block out in that case.
http://{$REEMCO_SITE_ADDRESS} {
	header -Server
	redir https://{host}{uri} 308
}
